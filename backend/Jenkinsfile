pipeline {
    agent any

    environment {
        DEPLOY_PATH = '/home/ubuntu/booknest'
    }

    stages {

        stage('Verify Build Tools') {
            steps {
                echo 'Checking Java and Maven on the Jenkins agent...'
                sh '''
                    java -version
                    if [ -f backend/book-service/mvnw ]; then
                      chmod +x backend/book-service/mvnw
                    fi
                    if [ -f backend/auth-service/mvnw ]; then
                      chmod +x backend/auth-service/mvnw
                    fi
                    mvn -version || true
                '''
            }
        }

        stage('Build Core Services') {
            steps {
                echo 'Building core backend services...'
                sh '''
                    set -e

                    cd backend/discovery-server
                    mvn clean package -DskipTests

                    cd ../auth-service
                    mvn clean package -DskipTests

                    cd ../book-service
                    ./mvnw clean package -DskipTests

                    cd ../api-gateway
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Prepare Deployment Files') {
            steps {
                echo 'Preparing deployment bundle...'
                sh '''
                    set -e
                    mkdir -p ${DEPLOY_PATH}

                    cp backend/discovery-server/target/*.jar ${DEPLOY_PATH}/
                    cp backend/auth-service/target/*.jar ${DEPLOY_PATH}/
                    cp backend/book-service/target/*.jar ${DEPLOY_PATH}/
                    cp backend/api-gateway/target/*.jar ${DEPLOY_PATH}/
                    cp backend/start-services.sh ${DEPLOY_PATH}/
                    chmod +x ${DEPLOY_PATH}/start-services.sh
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Restarting services on the server...'
                sh '''
                    set -e
                    ${DEPLOY_PATH}/start-services.sh
                '''
            }
        }
    }

    post {
        success {
            echo 'Backend pipeline completed successfully.'
        }
        failure {
            echo 'Backend pipeline failed.'
        }
    }
}
